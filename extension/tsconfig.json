{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "sourceMap": true,
    "lib": ["DOM", "ES2020"],
    "typeRoots": ["../node_modules/@types", "node_modules/@types", "./types"],
    "types": ["chrome"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
} 