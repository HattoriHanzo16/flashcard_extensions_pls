{
  "name": "pls-flashcards",
  "version": "1.0.0",
  "description": "Browser extension that turns highlighted web content into flashcards with gesture-based review",
  "main": "index.js",
  "scripts": {
    "build:extension": "cd extension && webpack --config webpack.config.js",
    "build:server": "cd server && tsc",
    "build": "npm run build:extension && npm run build:server",
    "start:server": "cd server && node dist/index.js",
    "dev:server": "cd server && nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "dev:extension": "cd extension && webpack --watch --config webpack.config.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:extension\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "flashcards",
    "browser-extension",
    "tensorflow",
    "gesture-recognition",
    "study-tool"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tensorflow-models/handpose": "^0.0.7",
    "@tensorflow/tfjs": "^3.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "mongoose": "^6.4.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.317",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.0",
    "@types/mongoose": "^5.11.97",
    "@types/supertest": "^2.0.12",
    "concurrently": "^7.6.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-fetch-mock": "^3.0.3",
    "mongodb-memory-server": "^8.16.1",
    "nodemon": "^2.0.22",
    "style-loader": "^3.3.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.7.4",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.10.0"
  }
}
